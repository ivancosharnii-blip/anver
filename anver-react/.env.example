# ===== Supabase =====
# Проект: zlnwlaubmcmhbwqkchzq (https://zlnwlaubmcmhbwqkchzq.supabase.co)
# Ключи выдаёт владелец проекта: Supabase Dashboard → Settings → API.
# Схема БД: supabase/schema.sql (применить в SQL Editor).

# URL проекта (публичный).
NEXT_PUBLIC_SUPABASE_URL=https://zlnwlaubmcmhbwqkchzq.supabase.co

# Публичный anon-ключ. Безопасен для клиента: RLS разрешает анониму
# только INSERT в orders/feedback (см. supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Сервисный ключ (опционально). ТОЛЬКО для серверного кода —
# НИКОГДА не передавать в клиентский код и не коммитить в git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Админ-панель =====
# Пароль входа в /admin. Обязателен: middleware/роуты /api/admin/* без него
# вернут ошибку. Смени на свой и не коммить в git.
ADMIN_PASSWORD=change-me-admin-password

# Telegram: уведомления о заказах в группу
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather; TELEGRAM_CHAT_ID — id группы (-100…)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
